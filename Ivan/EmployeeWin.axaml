<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Ivan.EmployeeWin"
        Title="Окно монтажника">
        <Grid>
                <StackPanel Margin="15" Spacing="10">
                        <!-- Заголовок -->
                        <TextBlock Text="Ваши текущие заказы:" 
                                   FontSize="16"
                                   Margin="0,0,0,10"/>
        
                        <!-- Список заказов -->
                        <ListBox x:Name="OrdersListBox" 
                                 Height="200"
                                 Background="White"
                                 BorderBrush="Gray"
                                 BorderThickness="1">
                                <!-- Пример статических данных (в реальном приложении будет заполняться из кода) -->
                               
                        </ListBox>
        
                        <!-- Кнопки управления -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="AcceptButton" 
                                        Content="Принять заказ" 
                                        Width="120"
                                        Padding="5"/>
                    
                                <Button x:Name="CompleteButton" 
                                        Content="Завершить заказ" 
                                        Width="120"
                                        Padding="5"
                                        IsEnabled="False"/>
                        </StackPanel>
        
                        <!-- Блок статуса -->
                        <TextBlock x:Name="StatusLabel"
                                   Text="Статус: не выбран заказ"
                                   FontWeight="Bold"/>
        
                        <!-- Поле комментария -->
                        <TextBlock Text="Комментарий к заказу:"/>
                        <TextBox x:Name="CommentBox" 
                                 Height="60"
                                 AcceptsReturn="True"
                                 Watermark="Введите комментарий..."
                                 IsEnabled="False"/>
                </StackPanel>
                
        </Grid>
</Window>
